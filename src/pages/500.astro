---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  error: unknown;
}

const { error } = Astro.props;
const pageTitle = "Server Error (500) — Refresh Rate Test";
const pageDescription = "An internal server error occurred.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
>
  <TopNav />

  <main class="mx-auto max-w-site flex-grow px-4 py-24 sm:px-6 text-center flex flex-col items-center justify-center min-h-[60vh]">
    <h1 class="font-display text-6xl font-semibold tracking-tight text-ink sm:text-8xl">
      500
    </h1>
    <h2 class="mt-4 font-display text-2xl font-medium text-ink">
      Internal Server Error
    </h2>
    <p class="mt-6 text-lg text-ink-muted max-w-xl mx-auto">
      Sorry, something went wrong on our end. We're looking into it.
    </p>
    {
      import.meta.env.DEV && error instanceof Error ? (
        <div class="mt-8 p-4 bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 rounded-lg text-left max-w-3xl w-full overflow-auto">
          <p class="font-mono text-sm whitespace-pre-wrap">{error.message}</p>
        </div>
      ) : null
    }
    <div class="mt-10">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-medium text-white shadow-sm transition-colors hover:bg-primary-hover focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
      >
        Go back home
      </a>
    </div>
  </main>

  <Footer />
</Layout>
