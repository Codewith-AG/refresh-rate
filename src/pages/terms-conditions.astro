---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import Footer from "../components/Footer.astro";

const title = "Terms & Conditions — Refresh Rate Test";
const description = "Terms and Conditions for using the Refresh Rate Test website and tools.";
---

<Layout title={title} description={description}>
  <TopNav />
  <main class="mx-auto max-w-site px-4 pb-24 sm:px-6">
    <section class="pt-14 pb-10 sm:pt-20">
      <h1 class="font-display text-4xl font-semibold tracking-[-0.03em] text-ink sm:text-5xl">
        Terms & Conditions
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted">
        Last updated: {new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
      </p>
    </section>

    <div class="prose prose-slate dark:prose-invert max-w-none">
      <p>
        Please read these Terms and Conditions carefully before using the Refresh Rate Test website.
      </p>
      <h2>Acceptance of Terms</h2>
      <p>
        By accessing and using this website, you accept and agree to be bound by the terms and provisions of this agreement. If you do not agree to abide by these terms, please do not use this service.
      </p>
      <h2>Use of the Service</h2>
      <p>
        Refresh Rate Test provides a free, browser-based tool to measure screen refresh rates. The service is provided "as is" and "as available". We do not guarantee that the service will be uninterrupted or error-free.
      </p>
      <h2>Accuracy of Information</h2>
      <p>
        While we strive to provide the most accurate refresh rate measurements possible, results may vary based on your hardware, browser, operating system, and current system load. We are not liable for any discrepancies or actions taken based on the test results.
      </p>
      <h2>Intellectual Property</h2>
      <p>
        The content, layout, design, data, and graphics on this website are protected by intellectual property laws. You may not reproduce, download, transmit, or distribute any part of this website without our prior written consent.
      </p>
      <h2>Limitation of Liability</h2>
      <p>
        In no event shall Refresh Rate Test, nor its creators, be liable for any indirect, incidental, special, consequential, or punitive damages arising out of or related to your use of the site or the tool.
      </p>
      <h2>Modifications to Terms</h2>
      <p>
        We reserve the right to modify these terms at any time. Your continued use of the site following any such modifications constitutes your acceptance of the new terms.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
