---
import BrandMark from "./BrandMark.astro";

const links = [
  { href: "/", label: "Test" },
  { href: "/how-it-works", label: "How it works" },
  { href: "/troubleshooting", label: "Troubleshooting" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-hairline bg-canvas/85 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-14 max-w-site items-center justify-between gap-4 px-4 sm:px-6"
    aria-label="Primary"
  >
    <a href="/" class="rounded-md" aria-label="Refresh Rate Test — home">
      <BrandMark />
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-2 text-sm transition-colors hover:text-ink",
                isActive(link.href) ? "text-ink" : "text-ink-subtle",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <!-- Dark mode toggle -->
      <button
        id="dark-toggle"
        aria-label="Toggle dark mode"
        class="rounded-md p-2 text-ink-subtle transition-colors hover:bg-surface-2 hover:text-ink"
      >
        <!-- Sun icon — visible in dark mode -->
        <svg
          id="icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="hidden"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Moon icon — visible in light mode -->
        <svg
          id="icon-moon"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <a
        href="/#test"
        class="rounded-md bg-primary px-3.5 py-2 text-sm font-medium text-on-primary transition-colors hover:bg-primary-hover"
      >
        Start test
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('dark-toggle');
    var sun = document.getElementById('icon-sun');
    var moon = document.getElementById('icon-moon');

    function syncIcons() {
      var isDark = document.documentElement.classList.contains('dark');
      sun.classList.toggle('hidden', !isDark);
      moon.classList.toggle('hidden', isDark);
    }

    // Sync icons on load (dark class may already be set by Layout script)
    syncIcons();

    btn.addEventListener('click', function () {
      var isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      syncIcons();
    });
  })();
</script>
